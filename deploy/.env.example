# AlphaAgent Docker deployment environment.

# === 镜像（CI 推 v* tag 自动产出 :latest；pull_policy:always 会自动拉新版）===
ALPHAAGENT_IMAGE=ghcr.io/zhanghecn/alphaagent-api:latest
ALPHAAGENT_WEB_IMAGE=ghcr.io/zhanghecn/alphaagent-web:latest
ALPHAAGENT_GATEWAY_IMAGE=ghcr.io/zhanghecn/alphaagent-gateway:latest

# === 运行环境 ===
ALPHAAGENT_ENV=production
ALPHAAGENT_API_PORT=8000
# 走网关同源后，对外只剩 GATEWAY_PORT；CORS 基本不再触发，保留以兼容直连调试。
CORS_ORIGINS=http://localhost
# 前端经网关同源访问后端，使用相对路径。
VITE_API_BASE_URL=/api

# === 网关认证 ===
# 管理员账号；首次部署若 ADMIN_PASSWORD 仍为 change-me 占位，docker-deploy.sh 会随机生成并打印。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
# JWT 签名密钥，≥32 字节；仍是占位值时脚本自动生成。
JWT_SECRET=change-me-32-bytes-or-longer-random-hex
JWT_TOKEN_TTL=24h
# 对外端口（网关），默认 80。
GATEWAY_PORT=80

# === 数据库 ===
POSTGRES_USER=alphaagent
POSTGRES_DB=alphaagent
POSTGRES_PASSWORD=change-me

# === 业务参数 ===
MARKET_TIMEOUT_SECONDS=8
MARKET_PAGE_SIZE=50

# Optional: Tushare Pro historical minute bars.
TUSHARE_TOKEN=
TUSHARE_API_URL=https://api.tushare.pro
TUSHARE_TIMEOUT_SECONDS=12

TZ=Asia/Shanghai
