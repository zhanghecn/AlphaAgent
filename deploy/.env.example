# AlphaAgent Docker deployment environment.

ALPHAAGENT_IMAGE=ghcr.io/zhanghecn/alphaagent-api:latest
ALPHAAGENT_WEB_IMAGE=ghcr.io/zhanghecn/alphaagent-web:latest

ALPHAAGENT_ENV=production
ALPHAAGENT_API_PORT=8000
ALPHAAGENT_WEB_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000/api

POSTGRES_USER=alphaagent
POSTGRES_DB=alphaagent
POSTGRES_PASSWORD=change-me

MARKET_TIMEOUT_SECONDS=8
MARKET_PAGE_SIZE=50

# Optional: Tushare Pro historical minute bars.
TUSHARE_TOKEN=
TUSHARE_API_URL=https://api.tushare.pro
TUSHARE_TIMEOUT_SECONDS=12

TZ=Asia/Shanghai
