ALPHAAGENT_ENV=local
ALPHAAGENT_API_HOST=0.0.0.0
ALPHAAGENT_API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:8000,http://localhost:8001,http://localhost:8002
MARKET_TIMEOUT_SECONDS=8
MARKET_PAGE_SIZE=50

# Optional: Tushare Pro historical minute bars.
# Requires a paid/authorized token with stk_mins minute-data access.
TUSHARE_TOKEN=
TUSHARE_API_URL=https://api.tushare.pro
TUSHARE_TIMEOUT_SECONDS=12

# Local Docker Compose persistence. Do not commit real secrets in .env.
POSTGRES_USER=alphaagent
POSTGRES_DB=alphaagent
POSTGRES_PASSWORD=change-me
