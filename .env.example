ALPHAAGENT_ENV=local
ALPHAAGENT_API_HOST=0.0.0.0
ALPHAAGENT_API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001,http://localhost:8002,http://127.0.0.1:8002
MARKET_TIMEOUT_SECONDS=8
MARKET_PAGE_SIZE=50

# Optional: Tushare Pro historical minute bars.
# Requires a paid/authorized token with stk_mins minute-data access.
TUSHARE_TOKEN=
TUSHARE_API_URL=https://api.tushare.pro
TUSHARE_TIMEOUT_SECONDS=12

# Local Docker Compose persistence. Do not commit real secrets in .env.
POSTGRES_USER=alphaagent
POSTGRES_DB=alphaagent
POSTGRES_PASSWORD=change-me

# Optional: frontend Docker build registry.
PNPM_REGISTRY=https://registry.npmmirror.com

# === 网关认证（本地 docker compose 启动需要）===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-local-only
# 必须 ≥32 字节，否则网关启动 fail-fast。
JWT_SECRET=local-dev-secret-32-bytes-minimum-padding
JWT_TOKEN_TTL=24h
# 网关对外端口（本地默认 8080，避免占用宿主机 80）。
GATEWAY_PORT=8080
