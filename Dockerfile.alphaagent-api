# =============================================================================
# AlphaAgent API Dockerfile
# =============================================================================
# Stage 1: Install Python dependencies
# Stage 2: Final runtime image
# =============================================================================

FROM python:3.13-slim AS python-deps

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_ONLY_BINARY=TA-Lib,numpy

WORKDIR /app

COPY pyproject.toml ./pyproject.toml
RUN python -m pip install --upgrade pip && \
    python -m pip install --no-cache-dir --group pyproject.toml:server

FROM python:3.13-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY --from=python-deps /usr/local /usr/local

COPY alphaagent ./alphaagent
COPY vnpy ./vnpy
COPY third_party ./third_party

ENV PYTHONPATH=/app/third_party/akshare:/app

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "alphaagent.server.main:app", "--host", "0.0.0.0", "--port", "8000"]
