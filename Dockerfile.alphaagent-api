FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY alphaagent/server/requirements.txt /tmp/alphaagent-server-requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/alphaagent-server-requirements.txt

COPY alphaagent ./alphaagent
COPY third_party ./third_party

ENV PYTHONPATH=/app/third_party/akshare:/app

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "alphaagent.server.main:app", "--host", "0.0.0.0", "--port", "8000"]
